name: Build Blog

on:
  push:
    paths:
      - 'blog-src/**'
    branches: [main]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: write
    steps:
      - uses: actions/checkout@v4

      - name: Setup Hugo
        uses: peaceiris/actions-hugo@v3
        with:
          hugo-version: 'latest'
          extended: true

      - name: Build blog
        run: |
          cd blog-src
          hugo --minify

      - name: Commit blog output
        run: |
          git config user.name "Blog Builder"
          git config user.email "blog@ilang.ai"
          git add blog/
          if git diff --staged --quiet; then
            echo "No changes to blog output"
          else
            git commit -m "build: update blog output [skip ci]"
            git push
          fi
